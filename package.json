{
  "name": "nakaatsu-world",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"process.exit(1)\"",
    "start": "wrangler dev --local",
    "lint": "eslint . --max-warnings 0",
    "fix:lint": "eslint . --fix --max-warnings 0",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "test": "node --test tests/*.test.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "deploy": "node scripts/verify-build.mjs --deploy && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "framer-motion": "^14.1.0",
    "parse5": "^8.0.1",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0"
}

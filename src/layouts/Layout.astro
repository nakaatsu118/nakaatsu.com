---
import '../styles/site.css';
import Analytics from '../components/Analytics.astro';
import { canonicalPath } from '../lib/urls.mjs';
interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: string;
  updatedAt?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'nakaatsuの個人サイトです。趣味のブログやポートフォリオをまとめています。',
  image = '/images/og_image.png',
  article = false,
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const preview =
  import.meta.env.SITE_PRODUCTION !== 'true' ||
  import.meta.env.SITE_TEST_FIXTURES === '1';
const pageTitle = `${title} | nakaatsu World`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="nakaatsu World" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@nakaatsu" />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
  </head>
  <body>
    {!preview && <Analytics />}
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <nav class="navigation" aria-label="メインナビゲーション">
      <a href="/" aria-label="nakaatsu World ホーム">
        <img
          src="/images/logo/naka_.svg"
          width="84"
          height="32"
          alt="nakaatsu"
        />
      </a>
      <div>
        <a href="/blog">Blog</a>
        <a href="/profile">Profile</a>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        Amazonのアソシエイトとして、nakaatsuは適格販売により収入を得ています。
      </p>
      <p>
        ©nakaatsu · <a href="/privacyPolicy">Privacy Policy</a>
      </p>
    </footer>
  </body>
</html>

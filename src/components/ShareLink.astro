---
import { canonicalPath } from '../lib/urls.mjs';
interface Props {
  title: string;
}
const share = new URL('https://twitter.com/share');
share.search = new URLSearchParams({
  url: new URL(canonicalPath(Astro.url.pathname), Astro.site).href,
  text: `${Astro.props.title} - nakaatsu World`,
}).toString();
---

<a class="share-link" href={share} target="_blank" rel="noopener noreferrer">
  Xで共有
</a>

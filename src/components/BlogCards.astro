---
import type { Blog } from '../lib/content';
import { blogPath, imageUrl, formatDate } from '../lib/urls.mjs';
import listing from '../styles/legacy/Blogs.module.css';
import home from '../styles/legacy/TopBlogs.module.css';
interface Props {
  blogs: Blog[];
  top?: boolean;
}
const { blogs, top = false } = Astro.props;
const styles = top ? home : listing;
---

<ul
  class:list={['blog-grid', top ? home.blogContainer : listing.blogsContainer]}
>
  {blogs.map((blog, i) => (
    <li class={styles.blog}>
      <a class="blog-card" href={blogPath(blog.id)}>
        <div class={styles.imageContainer}>
          <img
            src={imageUrl(blog.eyecatch, 480, 480)}
            width="480"
            height="480"
            alt={blog.title}
            loading={i < 3 ? 'eager' : 'lazy'}
          />
          {blog.category && (
            <span class={styles.category}>{blog.category.name}</span>
          )}
        </div>
        <div class={styles.text}>
          <time datetime={blog.publishedAt}>
            {formatDate(blog.publishedAt)}
          </time>
          <h2>{blog.title}</h2>
        </div>
      </a>
    </li>
  ))}
</ul>

---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import CardHeader from '../components/CardHeader.astro';
import Icon from '../components/Icon.astro';
import BlogCards from '../components/BlogCards.astro';
import { getContent } from '../lib/content';
import welcome from '../styles/legacy/Welcome.module.css';
import top from '../styles/legacy/TopBlogs.module.css';
const { blogs } = await getContent();
---

<Layout title="Welcome!">
  <section class={welcome.whatIsWrapper} data-reveal>
    <Card>
      <CardHeader
        title="Welcome!"
        icon="/images/Icon_nakaatsu_.webp"
        link="/"
        share
        primary
      />
      <div class:list={['hero', welcome.imageContainer]}>
        <img
          src="/images/nakaatsu_top.webp"
          alt="main Image"
          width="1200"
          height="800"
          fetchpriority="high"
        />
      </div>
      <div class={welcome.mainContent}>
        <div class={welcome.actionContainer}>
          <nav class:list={['social', welcome.leftAction]} aria-label="SNS">
            <a
              href="https://x.com/nakaatsu"
              aria-label="X"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="x" class={`${welcome.actionIcon} ${welcome.x}`} />
            </a>
            <a
              href="https://www.instagram.com/nakaatsu_world/"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon
                name="instagram"
                class={`${welcome.actionIcon} ${welcome.instagram}`}
              />
            </a>
            <a
              href="https://github.com/nakaatsu118"
              aria-label="GitHub"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon
                name="github"
                class={`${welcome.actionIcon} ${welcome.github}`}
              />
            </a>
          </nav>
        </div>
        <div class={welcome.titleContainer}>
          <h3 class={welcome.title}>このサイトについて</h3>
        </div>
        <div class={welcome.bodyContainer}>
          こんにちは。なかあつです。このサイトは
          <a href="/profile" class={welcome.link}>
            @nakaatsu
          </a>
          の日々をしたためています。
          <br />
          多趣味でごっちゃにななかあつの世界がここにあります。
          <br />
          <br />
          🔥Next.js / React / TypeScript
          <br />
          🐠Aquarium / 🌿Plants / 👨‍🍳Cooking / 📸Gadget
          <br />
        </div>
      </div>
    </Card>
  </section>
  <section class={top.topBlogsWrapper} data-reveal>
    <Card>
      <CardHeader title="Blog" icon="/images/blog.webp" link="/blog" />
      <BlogCards blogs={blogs.slice(0, 6)} top />
    </Card>
  </section>
</Layout>
